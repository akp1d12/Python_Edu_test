import re

acc_nos = ['xkn59438', 'yhdck2', 'eihd39d9', 'chdsye847', 'hedle3455', 'xjhd53e', '45da', 'de37dp']

for accession in acc_nos:
    if re.search(r'5', accession):
        print(accession + " : Contains the number 5")

for accession in acc_nos:
    if re.search(r'(d|e)', accession):
        print(accession + " : Contains a 'd' or 'e'")

for accession in acc_nos:
    if re.search(r'de', accession):
        print(accession + " : Contains a 'd and e' in that order")

for accession in acc_nos:
    if re.search(r'd[a-zA-Z]e', accession):
        print(accession + " : Contains a 'd and e' in that order with a single letter in between them")

for accession in acc_nos:
    if re.search(r'(e.*d|d.*e)', accession):
        print(accession + " : Contains both the letters 'd' and 'e' in any order")

for accession in acc_nos:
    if re.search(r'^(x|y)', accession):
        print(accession + " : Starts with X or Y")

for accession in acc_nos:
    if re.search(r'^(x|y).*e$', accession):
        print(accession + " : Starts with X or Y and ends with e")

for accession in acc_nos:
    if re.search(r'\d{3,}', accession):
        print(accession + " : contain 3 or more digits in a row")

for accession in acc_nos:
    if re.search(r'd(a|r|p)$', accession):
        print(accession + " : end with d followed by either a, r or p")

